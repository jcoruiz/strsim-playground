#!/bin/sh
# Rejects a commit whose first line isn't a Conventional Commit in English.
# Installed by the repo-standards skill; see AGENTS.md › Git conventions.
message=$(grep -v '^#' "$1")
subject=$(printf '%s\n' "$message" | sed -n '1p')
second=$(printf '%s\n' "$message" | sed -n '2p')

case "$subject" in
  "Merge "* | 'Revert "'* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

# Characters, not bytes: drop UTF-8 continuation bytes before counting.
length=$(printf '%s' "$subject" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9/._-]*\))?!?: [^ ].*[^. ]$' ||
  [ "$length" -gt 72 ] || [ -n "$second" ]; then
  cat >&2 <<MSG
The first line must be a Conventional Commit in English, at most 72 characters, followed by a blank line:

  type(scope): subject in the imperative, without a final period

  feat(auth): sign in with Google

Types: feat fix docs style refactor perf test build ci chore revert. See AGENTS.md › Git conventions.

Got ($length characters): $subject
MSG
  exit 1
fi
