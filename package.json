{
  "name": "strsim-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "wasm": "scripts/build-wasm.sh",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run wasm && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
